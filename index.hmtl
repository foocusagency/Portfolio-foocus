<script>
const reels = [
  {url:'https://www.instagram.com/reel/DWAM-OmjsHa/',code:'DWAM-OmjsHa',label:'Reel 01'},
  {url:'https://www.instagram.com/reel/DYICojXtECO/',code:'DYICojXtECO',label:'Reel 02'},
  {url:'https://www.instagram.com/reel/DWrWmLhBSg6/',code:'DWrWmLhBSg6',label:'Reel 03'},
  {url:'https://www.instagram.com/reel/DVzG7LRkVop/',code:'DVzG7LRkVop',label:'Reel 04'},
  {url:'https://www.instagram.com/reel/DTyhJDTkS1D/',code:'DTyhJDTkS1D',label:'Reel 05'},
  {url:'https://www.instagram.com/reel/DTVl6KTEc4t/',code:'DTVl6KTEc4t',label:'Reel 06'},
  {url:'https://www.instagram.com/reel/DYN1Tr4MUU2/',code:'DYN1Tr4MUU2',label:'Reel 07'},
  {url:'https://www.instagram.com/reel/DYiXIolxN0u/',code:'DYiXIolxN0u',label:'Reel 08'},
  {url:'https://www.instagram.com/reel/DX7ZIr_pAoO/',code:'DX7ZIr_pAoO',label:'Reel 09'},
  {url:'https://www.instagram.com/reel/DXVHQRajim4/',code:'DXVHQRajim4',label:'Reel 10'},
  {url:'https://www.instagram.com/reel/DYskLvjxGTd/',code:'DYskLvjxGTd',label:'Reel 11'},
  {url:'https://www.instagram.com/reel/DUTv6dWCf7v/',code:'DUTv6dWCf7v',label:'Reel 12'},
  {url:'https://www.instagram.com/reel/DMS5ie2NGnh/',code:'DMS5ie2NGnh',label:'Reel 13'},
  {url:'https://www.instagram.com/reel/DHWzwsFSHM7/',code:'DHWzwsFSHM7',label:'Reel 14'},
  {url:'https://www.instagram.com/reel/DE8HypdPVxP/',code:'DE8HypdPVxP',label:'Reel 15'},
];

const container = document.getElementById('reels-container');
reels.forEach((r,i) => {
  container.innerHTML += `
    <a class="reel-card" href="${r.url}" target="_blank" rel="noopener">
      <span class="reel-num">0${i+1 < 10 ? (i+1) : ''}</span>
      <div class="reel-play">
        <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
      </div>
      <div class="reel-label">${r.label}</div>
      <div class="reel-ig">@Foocus.ag</div>
      <div class="reel-corner"><svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z"/></svg></div>
    </a>`;
});

function switchTab(tab, btn) {
  document.querySelectorAll('.ptab').forEach(b=>b.classList.remove('active'));
  document.querySelectorAll('.ptab-content').forEach(c=>c.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById('tab-'+tab).classList.add('active');
}

function setLang(lang) {
  document.body.className='lang-'+lang;
  document.querySelectorAll('.lang-btn').forEach(b=>b.classList.remove('active'));
  document.querySelector(`.lang-btn[onclick="setLang('${lang}')"]`).classList.add('active');
}
</script>
